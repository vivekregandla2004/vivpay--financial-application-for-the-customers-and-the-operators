# VivPay Environment Variables Example Template
# Duplicate this file to .env and provide your deployment-specific values.

# GEMINI_API_KEY: Required for server-side Gemini AI calls in Ask Viv Copilot.
# In AI Studio, this is injected automatically from project secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# SESSION_SECRET: Cryptographic secret for signing auth tokens and sessions
SESSION_SECRET="vivpay_super_secret_session_key_2026_change_in_production"

